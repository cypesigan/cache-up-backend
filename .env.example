# Copy this file to ".env" for local development. Never commit the real .env file.
# On your host (Render / Railway / ...) set the same names under "Environment Variables".

PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string (Atlas > Connect > Drivers). Keep "/cacheup" as the database name.
# Local MongoDB alternative: mongodb://127.0.0.1:27017/cacheup
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/cacheup

# Long random string used to sign login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string

# Where the frontend lives. Comma separated, * wildcards allowed. Leave empty to allow any origin.
CLIENT_URL=http://localhost:5173,https://your-app.vercel.app

# Load the demo data automatically when the database has no users (set to false after your real data exists)
AUTO_SEED=true
# Password given to every demo account. Defaults to password123 if empty - set your own for anything public.
SEED_PASSWORD=
# Allows admins to wipe + reload demo data via POST /api/admin/reseed
ALLOW_RESEED=false

# Neon Postgres (user accounts: registration + login). `neon deploy` fills these in for you,
# or copy the connection string from the Neon console. DATABASE_URL is the pooled one the API uses.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_UNPOOLED=
